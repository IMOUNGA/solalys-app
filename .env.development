APP_ENV=dev
# EXPO_PUBLIC_API volontairement non défini ici : lib/env.ts choisit déjà la bonne
# valeur par plateforme (10.0.2.2 sur émulateur Android, localhost sur iOS/web).
# Ne décommenter que pour forcer une URL précise (ex: test sur device physique
# via l'IP LAN de la machine).
# EXPO_PUBLIC_API=http://192.168.1.x:3000
