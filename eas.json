{
  "cli": {
    "version": ">= 11.0.3"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "preprod"
      }
    },
    "production": {
      "env": {
        "APP_ENV": "prod"
      }
    },
    "testflight-preprod": {
      "extends": "production",
      "env": {
        "APP_ENV": "preprod"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
